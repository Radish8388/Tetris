<Window x:Class="Tetris.Abandon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        mc:Ignorable="d"
        Title="Abandon"
        Height="200" Width="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Background="LightBlue">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Are you sure you" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="want to abandon" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="the current game?" FontSize="24" HorizontalAlignment="Center"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Content="Yes" Width="60" Margin="0,20,30,0" 
                    HorizontalAlignment="Center" IsDefault="True"
                    Click="YesButton_Click"/>
                <Button Content="No" Width="60" Margin="0,20,0,0" 
                    HorizontalAlignment="Center" IsCancel="True"
                    Click="NoButton_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
