<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        mc:Ignorable="d"
        Title="Tetris"
        Height="800" Width="800"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="P_lay" Click="NewGame_Click"/>
            <MenuItem Header="_Settings" Click="Settings_Click"/>
            <MenuItem x:Name="PauseMenuItem" Header="_Pause" Click="Pause_Click"/>
            <MenuItem Header="S_cores" Click="Scores_Click"/>
            <MenuItem Header="_Help" Click="Help_Click"/>
        </Menu>

        <Grid Background="ForestGreen">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="HOLD" FontSize="24" Grid.Row="0" Grid.Column="0"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Text="NEXT" FontSize="24" Grid.Row="0" Grid.Column="2"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Canvas x:Name="GameCanvas" Grid.RowSpan="2" Grid.Column="1" SizeChanged="GameCanvas_SizeChanged"/>
            <Canvas x:Name="NextCanvas" Grid.Row="1" Grid.Column="2"/>
            <TextBlock x:Name="CountdownText" Grid.Row="1" Grid.Column="1" FontSize="300" Text="3"
                       Visibility="Collapsed"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="HoldCanvas" Grid.Row="0" Grid.Column="0"/>
                <Border BorderThickness="8" BorderBrush="White" Grid.Row="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        
                        <TextBlock Text="SCORE" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                        <Border Background="Black" Width="150" Height="40" Margin="0,0,0,25">
                            <TextBlock x:Name="ScoreText" Text="0" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="LEVEL" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                        <Border Background="Black" Width="150" Height="40" Margin="0,0,0,25">
                            <TextBlock x:Name="LevelText" Text="1" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="LINES" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                        <Border Background="Black" Width="150" Height="40" Margin="0,0,0,0">
                            <TextBlock x:Name="LinesText" Text="0" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>

                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
